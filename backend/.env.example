# ========================================================
# CẤU HÌNH BIẾN MÔ TRƯỜNG DỰ ÁN QUẢN LÝ TRUNG TÂM (LMS)
# ========================================================

# 1. Server Port & Environment Mode
PORT=3001
NODE_ENV=production

# 2. Database Choice ('sqlite' hoặc 'postgres')
# Chế độ Dev local: DB_DIALECT=sqlite (không cần DATABASE_URL)
# Chế độ Production: DB_DIALECT=postgres
DB_DIALECT=postgres
DATABASE_URL=postgres://username:password@postgres-host.render.com:5432/quanlytrungtam?ssl=true

# 3. Security & Session Key
SESSION_SECRET=super_secret_key_quanlytrungtam_2026_xyz

# 4. Cloudinary Storage (Tùy chọn cho Upload Ảnh & File)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. VNPay Payment Gateway (Tùy chọn cho Thanh toán Học phí Live)
VNP_TMNCODE=your_vnpay_tmncode
VNP_HASHSECRET=your_vnpay_hashsecret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURNURL=https://your-domain.com/Auth/ConfirmGatewayPayment
