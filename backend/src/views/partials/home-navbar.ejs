<% /* Partial: home-navbar.ejs Variables expected from parent scope: - isLoggedIn (bool) - currentUserFullName (string)
  - currentUserRole (string|number) - activePage: 'home' | 'courses' | 'teachers' | 'news' | 'documents' */ var
  _activePage=(typeof activePage !=='undefined' ) ? activePage : '' ; var _isLoggedIn=(typeof isLoggedIn !=='undefined'
  ) ? isLoggedIn : false; var _fullName=(typeof currentUserFullName !=='undefined' ) ? currentUserFullName : '' ; var
  _role=(typeof currentUserRole !=='undefined' ) ? currentUserRole : null; var navDashboardUrl='/Student/Dashboard' ; if
  (_role==='ADMIN' || _role==='STAFF' || _role===0 || _role===1) { navDashboardUrl='/Admin/Dashboard' ; } else if
  (_role==='TEACHER' || _role===2) { navDashboardUrl='/Teacher/Dashboard' ; } %>
  <style>
    /* Navigation capsule on light pages / scrolled */
    #navbar nav.glass-premium {
        background-color: #f1f5f9 !important;
        border: 1px solid #cbd5e1 !important;
        box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.05) !important;
        transition: all 0.3s ease;
    }
    #navbar nav.glass-premium a {
        color: #334155 !important;
        font-weight: 700 !important;
        font-size: 13px !important;
        text-shadow: none !important;
        transition: all 0.2s ease;
    }
    #navbar nav.glass-premium a:hover {
        color: #2563eb !important;
    }
    #navbar nav.glass-premium a.font-bold {
        color: #1d4ed8 !important;
        font-weight: 800 !important;
    }

    /* Navigation capsule on Home Page Top (Dark Hero Overlay) */
    #navbar.navbar-top.is-home-page nav.glass-premium {
        background-color: rgba(15, 23, 42, 0.45) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
    }
    #navbar.navbar-top.is-home-page nav.glass-premium a {
        color: #ffffff !important;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8) !important;
    }
    #navbar.navbar-top.is-home-page nav.glass-premium a:hover {
        color: #38bdf8 !important;
    }
    #navbar.navbar-top.is-home-page nav.glass-premium a.font-bold {
        color: #38bdf8 !important;
    }

    .nav-login-btn {
        transition: all 0.2s ease !important;
    }
  </style>
  <header id="navbar" class="w-full fixed top-0 z-[100] transition-all duration-300 bg-white/95 backdrop-blur-md shadow-sm border-b border-slate-200/80">
    <div id="navbar-container"
      class="relative z-10 max-w-7xl mx-auto px-5 lg:px-8 py-3 transition-all duration-300 flex justify-between items-center flex-nowrap gap-2">

      <!-- Logo -->
      <div class="flex items-center gap-2 shrink-0">
        <a href="/" class="flex items-center gap-2">
          <img alt="Logo" class="h-14 w-auto" src="/images/logo.png?v=3" />
          <span id="logo-text-nav" class="font-black text-xl hidden sm:block tracking-wide text-slate-900">
            TrungTâmOnline
          </span>
        </a>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center space-x-6 glass-premium rounded-full px-10 py-2.5 shadow-sm bg-slate-100/90 border border-slate-200">
        <a href="/"
          class="text-[12px] font-semibold transition-all whitespace-nowrap <%= _activePage === 'home' ? 'text-blue-700 font-bold relative after:content-[\'\'] after:absolute after:bottom-[-4px] after:left-0 after:w-full after:h-[2px] after:bg-blue-600' : 'text-slate-700 hover:text-blue-600' %>">
          Trang Chủ
        </a>
        <a href="/Home/Courses"
          class="text-[12px] font-semibold transition-all whitespace-nowrap <%= _activePage === 'courses' ? 'text-blue-700 font-bold relative after:content-[\'\'] after:absolute after:bottom-[-4px] after:left-0 after:w-full after:h-[2px] after:bg-blue-600' : 'text-slate-700 hover:text-blue-600' %>">
          Khóa Học
        </a>
        <a href="/Home/Teachers"
          class="text-[12px] font-semibold transition-all whitespace-nowrap <%= _activePage === 'teachers' ? 'text-blue-700 font-bold relative after:content-[\'\'] after:absolute after:bottom-[-4px] after:left-0 after:w-full after:h-[2px] after:bg-blue-600' : 'text-slate-700 hover:text-blue-600' %>">
          Giáo Viên
        </a>
        <a href="/Home/News"
          class="text-[12px] font-semibold transition-all whitespace-nowrap <%= _activePage === 'news' ? 'text-blue-700 font-bold relative after:content-[\'\'] after:absolute after:bottom-[-4px] after:left-0 after:w-full after:h-[2px] after:bg-blue-600' : 'text-slate-700 hover:text-blue-600' %>">
          Tin Tức
        </a>
        <a href="/Home/Documents"
          class="text-[12px] font-semibold transition-all whitespace-nowrap <%= _activePage === 'documents' ? 'text-blue-700 font-bold relative after:content-[\'\'] after:absolute after:bottom-[-4px] after:left-0 after:w-full after:h-[2px] after:bg-blue-600' : 'text-slate-700 hover:text-blue-600' %>">
          Tài Liệu
        </a>
      </nav>

      <!-- Auth Buttons -->
      <div class="flex items-center gap-2">
        <% if (_isLoggedIn) { %>
          <span class="hidden xl:flex items-center text-sm font-semibold text-slate-700 gap-1 whitespace-nowrap">Xin
            chào, <%= _fullName %></span>
          <a href="<%= navDashboardUrl %>"
            class="bg-blue-600 text-white px-5 py-2.5 rounded-full text-sm font-bold flex items-center gap-1.5 whitespace-nowrap hover:bg-blue-700 transition-all shadow-md active:scale-95">
            <span class="material-symbols-outlined text-[17px]">dashboard</span>
            <span class="hidden xl:inline">Bảng Điều Khiển</span>
          </a>
          <!-- Nút Thông báo -->
          <a href="/Notification"
            style="position: relative; padding: 0; display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: rgba(30, 58, 138, 0.05); color: #1e3a8a; border: 1.5px solid rgba(30, 58, 138, 0.1); text-decoration: none;"
            title="Thông báo" class="hover:bg-slate-200 transition-all">
            <i class="fa-solid fa-bell" style="font-size: 1.1rem; margin: 0;"></i>
            <span id="notifBadge"
              style="position: absolute; top: -3px; right: -3px; background: #EF4444; color: white; font-size: 0.65rem; font-weight: 800; border-radius: 50%; width: 18px; height: 18px; display: none; align-items: center; justify-content: center; border: 2px solid white; line-height: 1;">0</span>
          </a>

          <!-- Nút Trang cá nhân (Avatar) -->
          <% const avatarUrl=(typeof currentUserAvatarUrl !=='undefined' ) ? currentUserAvatarUrl : null; const
            initial=_fullName ? _fullName.charAt(0).toUpperCase() : "U" ; %>
            <a href="<%= navDashboardUrl %>"
              style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #1e3a8a, #2563eb); color: white; font-weight: 700; font-size: 0.9rem; cursor: pointer; border: 2px solid rgba(30, 58, 138, 0.2); box-shadow: 0 2px 8px rgba(0,0,0,0.12); text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease;"
              title="Xem thông tin cá nhân" class="hover:scale-105 transition-all">
              <% if (avatarUrl) { %>
                <img src="<%= avatarUrl %>" alt="<%= _fullName %>"
                  style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
                <% } else { %>
                  <span>
                    <%= initial %>
                  </span>
                  <% } %>
            </a>
            <% } else { %>
              <a id="login-btn-nav" href="/Auth/Login"
                class="hidden lg:flex items-center text-sm font-bold text-slate-800 hover:text-blue-600 transition-all whitespace-nowrap px-5 py-2.5 rounded-full nav-login-btn">
                Đăng Nhập
              </a>
              <a id="register-btn-nav" href="/Auth/Register"
                class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-full text-sm font-bold flex items-center gap-1.5 whitespace-nowrap transition-all shadow-md active:scale-95">
                Đăng Ký
              </a>
              <% } %>
      </div>

    </div>

  <script>
    const isHomePage = <%= _activePage === 'home' ? 'true' : 'false' %>;
    const handleScroll = () => {
      const nav = document.getElementById('navbar');
      const logoTextNav = document.getElementById('logo-text-nav');
      const loginBtnNav = document.getElementById('login-btn-nav');
      if (nav) {
        if (!isHomePage || window.scrollY > 50) {
          nav.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-slate-200/80');
          nav.classList.remove('bg-transparent', 'navbar-top', 'is-home-page');
          if (logoTextNav) {
            logoTextNav.style.color = '#0f172a';
            logoTextNav.style.textShadow = 'none';
          }
          if (loginBtnNav) {
            loginBtnNav.style.color = '#1e293b';
            loginBtnNav.style.textShadow = 'none';
          }
        } else {
          nav.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-slate-200/80');
          nav.classList.add('bg-transparent', 'navbar-top', 'is-home-page');
          if (logoTextNav) {
            logoTextNav.style.color = '#ffffff';
            logoTextNav.style.textShadow = '0 2px 4px rgba(0,0,0,0.8)';
          }
          if (loginBtnNav) {
            loginBtnNav.style.color = '#ffffff';
            loginBtnNav.style.textShadow = '0 2px 4px rgba(0,0,0,0.8)';
          }
        }
      }
    };
    window.addEventListener('scroll', handleScroll);
    handleScroll();
  </script>
  </header>