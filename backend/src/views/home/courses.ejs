<% title = "Khóa Học - Chương trình đào tạo trực tuyến"; %>
<!DOCTYPE html>
<html class="scroll-smooth" lang="vi"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary": "#1e3a8a", // Deeper Edu Blue (Blue 900)
                        "on-primary": "#ffffff",
                        "primary-container": "#dbeafe",
                        "on-primary-container": "#172554",
                        "secondary": "#2563eb", // More saturated Blue 600
                        "surface": "#fdfbf7",
                        "on-surface": "#0b1120",
                        "surface-variant": "#f6f4eb",
                        "on-surface-variant": "#334155",
                        "outline": "#94a3b8",
                        "background": "#fdfbf7",
                        "on-background": "#0b1120",
                        "surface-container-low": "#faf8f0",
                        "surface-container": "#f6f4eb",
                        "surface-container-high": "#f0eee2",
                        "surface-container-highest": "#eae8d8",
                        "surface-container-lowest": "#ffffff",
                        "outline-variant": "#cbd5e1",
                        "vibrant-blue": "#1d4ed8", // Darker Blue 700
                        "vibrant-sky": "#0369a1" // Darker Sky 800
                    },
                    "borderRadius": {
                        "DEFAULT": "0.5rem",
                        "lg": "0.75rem",
                        "xl": "1rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "max-width": "1280px",
                        "gutter": "24px",
                        "margin-mobile": "16px",
                        "margin-desktop": "64px",
                        "base": "8px"
                    },
                    "fontFamily": {
                        "sans": ["Inter", "Manrope", "sans-serif"],
                        "serif": ["Source Serif 4", "serif"]
                    }
                }
            }
        }
    </script>
<style>
        .glass-premium {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .blended-gradient {
            background: linear-gradient(135deg, #1e3a8a 0%, #172554 100%);
            /* Deepened gradient */
        }

        .hero-blended-bg {
            background-image: radial-gradient(circle at 70% 30%, rgba(30, 58, 138, 0.2) 0%, transparent 70%),
                linear-gradient(135deg, rgba(30, 58, 138, 0.1) 0%, rgba(23, 37, 84, 0.1) 100%);
            background-size: cover;
            background-position: center;
        }

        .platinum-white-gradient {
            background: linear-gradient(180deg, #f1f5f9 0%, #ffffff 100%);
        }

        .text-gradient {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .card-shadow {
            box-shadow: 0 20px 40px -15px rgba(30, 58, 138, 0.15);
        }

        .hover-lift {
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .hover-lift:hover {
            transform: translateY(-8px);
        }

        .carousel-track {
            display: flex;
            transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
        }

        @keyframes shake {

            0%,
            100% {
                transform: rotate(0);
            }

            25% {
                transform: rotate(-10deg);
            }

            75% {
                transform: rotate(10deg);
            }
        }

        .contact-shake:hover .material-symbols-outlined {
            animation: shake 0.3s infinite;
        }
    </style>
</head>
<body class="antialiased font-sans bg-surface text-on-surface">
<%- include('../partials/home-navbar', { activePage: 'courses', isLoggedIn: isLoggedIn, currentUserFullName: currentUserFullName, currentUserRole: currentUserRole }) %>
<main class="pt-0">
<!-- Hero Section -->
<%- include('../partials/home-hero', { heroIcon: 'library_books', heroTitle: 'Tất Cả Khóa Học', heroDesc: 'Khám phá chương trình đào tạo đa dạng - được thiết kế bởi đội ngũ giáo viên giỏi nhất.', heroBreadcrumb: 'Khóa Học', heroStats: [] }) %>
<!-- Filters & Search Section -->
<section class="py-12 relative border-b border-surface-container" class="py-12 relative border-b border-surface-container bg-surface">
<div class="max-w-7xl mx-auto px-margin-mobile lg:px-8">
<div class="flex flex-col lg:flex-row justify-between items-center gap-6">
<!-- Search Bar -->
<div class="w-full lg:max-w-md relative">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
<input class="w-full pl-12 pr-6 py-4 bg-white border border-surface-container rounded-full text-sm focus:ring-2 focus:ring-primary focus:border-transparent outline-none shadow-sm" id="searchInput" placeholder="Tìm kiếm tên khóa học, môn học..." type="text" oninput="filterCourses()"/>
</div>
<!-- Filter Buttons -->
<div class="flex items-center gap-3 overflow-x-auto pb-2 lg:pb-0 no-scrollbar w-full lg:w-auto" id="filterBtns">
<button class="px-8 py-3 bg-primary text-white rounded-full text-sm font-bold shadow-lg shadow-primary/20 whitespace-nowrap filter-btn active" onclick="setFilter('all', this)">Tất Cả</button>
<button class="px-8 py-3 bg-white border border-surface-container text-on-surface font-bold rounded-full text-sm hover:bg-surface-container transition-colors whitespace-nowrap filter-btn" onclick="setFilter('toán', this)">Toán Học</button>
<button class="px-8 py-3 bg-white border border-surface-container text-on-surface font-bold rounded-full text-sm hover:bg-surface-container transition-colors whitespace-nowrap filter-btn" onclick="setFilter('vật lý', this)">Vật Lý</button>
<button class="px-8 py-3 bg-white border border-surface-container text-on-surface font-bold rounded-full text-sm hover:bg-surface-container transition-colors whitespace-nowrap filter-btn" onclick="setFilter('hóa', this)">Hóa Học</button>
<button class="px-8 py-3 bg-white border border-surface-container text-on-surface font-bold rounded-full text-sm hover:bg-surface-container transition-colors whitespace-nowrap filter-btn" onclick="setFilter('tiếng anh', this)">Tiếng Anh</button>
</div>
</div>
<!-- Course Grid -->
<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mt-16" id="courseGrid">
<% if (courses && courses.length > 0) { %>
    <% courses.forEach(function(course) { %>
    <% 
        const title = course.Title || course.CourseName || 'Khóa học chất lượng cao';
        const imgUrl = course.ImageUrl || course.ThumbnailUrl || '/images/course_tienganh11.jpg';
        const price = Number(course.BasePrice || course.Price || 2600000);
        const originalPrice = course.OriginalPrice || (price > 0 ? Math.round((price * 1.23) / 100000) * 100000 : 3200000);
        const discountPercent = course.DiscountPercent || (originalPrice > price ? Math.round(((originalPrice - price) / originalPrice) * 100) : 19);
        const teacherName = course.TeacherName || 'Nguyễn Thị Mai';
        const lessonsCount = course.TotalLessons || 24;
        const durationHours = Math.round((lessonsCount * 30) / 60) || 12;
        const studentsCount = course.EnrolledStudentsCount || '6.2k';
        const gradeTag = title.toLowerCase().includes('12') ? 'Lớp 12' : (title.toLowerCase().includes('11') ? 'Lớp 11' : (title.toLowerCase().includes('10') ? 'Lớp 10' : 'Lớp 11'));
    %>
    <div class="bg-white rounded-[32px] p-4 border border-slate-100 shadow-[0_8px_26px_rgba(0,0,0,0.05)] hover:shadow-[0_16px_40px_rgba(0,0,0,0.1)] transition-all duration-300 flex flex-col justify-between group cursor-pointer course-card" data-name="<%= (title + ' ' + (course.MetadataTags || '')).toLowerCase() %>">
        <div>
            <!-- Banner Image & Badges -->
            <div class="relative aspect-[16/9] w-full overflow-hidden rounded-[22px] bg-slate-100">
                <img alt="<%= title %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="<%= imgUrl %>" onerror="this.src='/images/course_tienganh11.jpg'"/>
                
                <!-- Top-Left Badge -->
                <div class="absolute top-3 left-3 bg-[#065f46] text-white text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-md z-10">
                    <span class="material-symbols-outlined text-[16px] text-emerald-300">school</span>
                    <span>Khóa học nổi bật</span>
                </div>

                <!-- Top-Right Cart Button -->
                <a href="/Auth/Checkout?courseId=<%= course.Id || course.CourseId %>" class="absolute top-3 right-3 w-10 h-10 rounded-full bg-white text-[#047857] shadow-md flex items-center justify-center hover:bg-emerald-50 hover:scale-105 transition-all z-10 border border-slate-100">
                    <span class="material-symbols-outlined text-[20px]">add_shopping_cart</span>
                </a>

                <!-- Bottom-Left Grade Badge -->
                <div class="absolute bottom-3 left-3 bg-black/60 backdrop-blur-md text-white text-xs font-medium px-3 py-1 rounded-full flex items-center gap-1.5 border border-white/20 shadow-sm z-10">
                    <span class="material-symbols-outlined text-[15px] text-white/90">menu_book</span>
                    <span><%= gradeTag %></span>
                </div>
            </div>

            <!-- Title & Description -->
            <h3 class="text-lg font-black text-slate-900 leading-snug line-clamp-2 mt-4 group-hover:text-[#047857] transition-colors"><%= title %></h3>
            <p class="text-xs text-slate-500 leading-relaxed line-clamp-2 mt-1.5 font-normal">
                <%= course.Description || 'Hệ thống kiến thức trọng tâm, rèn kỹ năng làm bài và phát triển toàn diện 4 kỹ năng.' %>
            </p>

            <!-- 3-Column Info Row -->
            <div class="flex items-center justify-between mt-3.5 pt-3 border-t border-slate-100 gap-2">
                <!-- Col 1: Teacher -->
                <div class="flex items-center gap-2 min-w-0 flex-1">
                    <div class="w-9 h-9 rounded-full bg-[#e8f5e9] text-[#047857] flex items-center justify-center shrink-0 border border-emerald-100">
                        <span class="material-symbols-outlined text-[18px]">person</span>
                    </div>
                    <div class="min-w-0 leading-tight">
                        <div class="text-[10px] text-slate-400 font-medium">Giảng viên</div>
                        <div class="text-[12px] font-bold text-slate-800 truncate"><%= teacherName %></div>
                    </div>
                </div>

                <div class="h-7 w-[1px] bg-slate-100 shrink-0"></div>

                <!-- Col 2: Lessons -->
                <div class="flex items-center gap-2 min-w-0 flex-1 px-1">
                    <div class="w-9 h-9 rounded-xl bg-[#e8f5e9] text-[#047857] flex items-center justify-center shrink-0 border border-emerald-100">
                        <span class="material-symbols-outlined text-[18px]">play_circle</span>
                    </div>
                    <div class="min-w-0 leading-tight">
                        <div class="text-[12px] font-bold text-slate-800 whitespace-nowrap"><%= lessonsCount %> bài giảng</div>
                        <div class="text-[10px] text-slate-400 font-medium whitespace-nowrap">(<%= durationHours %> giờ học)</div>
                    </div>
                </div>

                <div class="h-7 w-[1px] bg-slate-100 shrink-0"></div>

                <!-- Col 3: Students -->
                <div class="flex items-center gap-2 min-w-0 shrink-0">
                    <div class="w-9 h-9 rounded-full bg-[#e8f5e9] text-[#047857] flex items-center justify-center shrink-0 border border-emerald-100">
                        <span class="material-symbols-outlined text-[18px]">group</span>
                    </div>
                    <div class="min-w-0 leading-tight">
                        <div class="text-[12px] font-bold text-slate-800 whitespace-nowrap"><%= studentsCount %> học viên</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Area: Rating, Price & Button -->
        <div class="pt-3">
            <div class="flex items-center gap-1.5">
                <span class="material-symbols-outlined text-amber-400 text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="font-extrabold text-sm text-slate-800">4.8</span>
                <span class="text-xs text-slate-400 font-normal">(2.4k đánh giá)</span>
            </div>

            <div class="flex items-baseline gap-2 mt-2">
                <span class="text-2xl font-black text-[#047857] tracking-tight"><%= price.toLocaleString('vi-VN') %>đ</span>
                <% if (originalPrice > price) { %>
                    <span class="text-xs font-semibold text-slate-400 line-through"><%= originalPrice.toLocaleString('vi-VN') %>đ</span>
                <% } %>
                <% if (discountPercent > 0) { %>
                    <span class="bg-[#ff3b69] text-white text-[10px] font-black px-2 py-0.5 rounded-full shadow-sm">-<%= discountPercent %>%</span>
                <% } %>
            </div>

            <a href="/Auth/Checkout?courseId=<%= course.Id || course.CourseId %>" class="w-full mt-3.5 py-3 px-4 rounded-full bg-[#047857] hover:bg-[#03543f] text-white font-bold text-sm flex items-center justify-center gap-2 shadow-[0_4px_14px_rgba(4,120,87,0.28)] hover:shadow-[0_6px_20px_rgba(4,120,87,0.38)] active:scale-[0.98] transition-all">
                <span class="material-symbols-outlined text-[20px]">shopping_cart</span>
                <span>Đăng ký ngay</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
        </div>
    </div>
    <% }); %>
<% } else { %>
<div class="col-span-3 text-center py-24">
    <span class="material-symbols-outlined text-[72px] text-on-surface-variant/30">school</span>
    <p class="text-on-surface-variant font-bold mt-4 text-lg">Chưa có khóa học nào được mở.</p>
    <p class="text-on-surface-variant text-sm mt-2">Vui lòng quay lại sau!</p>
</div>
<% } %>
</div>
<!-- No results message (shown via JS) -->
<div class="col-span-3 text-center py-24 hidden" id="noResultsMsg">
    <span class="material-symbols-outlined text-[72px] text-on-surface-variant/30">search_off</span>
    <p class="text-on-surface-variant font-bold mt-4 text-lg">Không tìm thấy khóa học phù hợp.</p>
    <p class="text-on-surface-variant text-sm mt-2">Thử từ khóa khác hoặc chọn danh mục khác.</p>
</div>
</div>
</section>
</main>
