<!DOCTYPE html>
<html class="scroll-smooth" lang="vi">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&amp;family=Source+Serif+4:wght@600;700&amp;family=Inter:wght@400;700;800&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block"
        rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary": "#064e3b",
                        "on-primary": "#ffffff",
                        "primary-container": "#d1fae5",
                        "on-primary-container": "#064e3b",
                        "secondary": "#10b981",
                        "accent": "#00e676",
                        "gold": "#ffd700",
                        "surface": "#fdfbf7",
                        "on-surface": "#0b1120",
                        "surface-variant": "#f6f4eb",
                        "on-surface-variant": "#334155",
                        "outline": "#94a3b8",
                        "background": "#fdfbf7",
                        "on-background": "#0b1120",
                        "surface-container-low": "#faf8f0",
                        "surface-container": "#f6f4eb",
                        "surface-container-high": "#f0eee2",
                        "surface-container-highest": "#eae8d8",
                        "surface-container-lowest": "#ffffff",
                        "outline-variant": "#cbd5e1",
                        "vibrant-blue": "#065f46",
                        "vibrant-sky": "#059669"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.5rem",
                        "lg": "0.75rem",
                        "xl": "1rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "max-width": "1280px",
                        "gutter": "24px",
                        "margin-mobile": "16px",
                        "margin-desktop": "64px",
                        "base": "8px"
                    },
                    "fontFamily": {
                        "sans": ["Inter", "Manrope", "sans-serif"],
                        "serif": ["Source Serif 4", "serif"]
                    }
                }
            }
        }
    </script>
    <style>
        @keyframes blob-float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(20px, -30px) scale(1.08); }
            66% { transform: translate(-15px, 15px) scale(0.95); }
        }
        .blob { animation: blob-float 14s ease-in-out infinite; }
        .blob-delay-2 { animation-delay: 3s; }
        .blob-delay-3 { animation-delay: 6s; }
    </style>
</head>

<body
    class="antialiased font-sans selection:bg-primary-container selection:text-on-primary-container bg-surface text-on-surface">
    <%- include('../partials/home-navbar', { activePage: 'home' , isLoggedIn: isLoggedIn, currentUserFullName:
        currentUserFullName, currentUserRole: currentUserRole }) %>

    <% const accents = [
        { ring: 'border-emerald-400', chip: 'bg-emerald-500', text: 'text-emerald-600', tint: 'bg-emerald-50', grad: 'from-emerald-500 to-emerald-600' },
        { ring: 'border-sky-400', chip: 'bg-sky-500', text: 'text-sky-600', tint: 'bg-sky-50', grad: 'from-sky-500 to-sky-600' },
        { ring: 'border-amber-400', chip: 'bg-amber-500', text: 'text-amber-600', tint: 'bg-amber-50', grad: 'from-amber-500 to-amber-600' },
        { ring: 'border-violet-400', chip: 'bg-violet-500', text: 'text-violet-600', tint: 'bg-violet-50', grad: 'from-violet-500 to-violet-600' }
    ];
    const spotlightCourse = (courses && courses.length > 0) ? courses[0] : null;
    const spotlightTeacherRaw = (teachers && teachers.length > 0) ? teachers[0] : null;
    let spotlightTeacher = null;
    if (spotlightTeacherRaw) {
        const p = spotlightTeacherRaw.Profile || {};
        spotlightTeacher = {
            fullName: spotlightTeacherRaw.FullName,
            avatarUrl: spotlightTeacherRaw.AvatarUrl || 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=256&auto=format&fit=crop',
            subject: p.Subject || 'Toán học',
            experience: p.TeacherExperience !== null && p.TeacherExperience !== undefined ? p.TeacherExperience : 5,
            students: p.TeacherStudents !== null && p.TeacherStudents !== undefined ? p.TeacherStudents : 100,
            rating: p.TeacherRating !== null && p.TeacherRating !== undefined ? parseFloat(p.TeacherRating).toFixed(1) : '4.8'
        };
    }
    %>

    <main>
        <!-- ===================== HERO SECTION ===================== -->
        <section class="relative min-h-screen flex items-center pt-32 pb-20 overflow-hidden bg-gradient-to-b from-white via-slate-50 to-white">
            <div class="absolute -top-24 -left-24 w-[420px] h-[420px] rounded-full bg-emerald-300/30 blur-3xl blob pointer-events-none"></div>
            <div class="absolute top-1/3 -right-32 w-[480px] h-[480px] rounded-full bg-sky-300/30 blur-3xl blob blob-delay-2 pointer-events-none"></div>
            <div class="absolute bottom-0 left-1/4 w-[380px] h-[380px] rounded-full bg-amber-300/25 blur-3xl blob blob-delay-3 pointer-events-none"></div>

            <div class="max-w-7xl mx-auto px-6 lg:px-margin-desktop relative z-10 w-full">
                <div class="grid lg:grid-cols-12 gap-12 items-center">

                    <!-- Left Column -->
                    <div class="lg:col-span-7 space-y-7">
                        <div class="inline-flex items-center gap-2 bg-white border border-emerald-200 px-4 py-2 rounded-full shadow-sm">
                            <span class="material-symbols-outlined text-emerald-500 text-[18px]">auto_awesome</span>
                            <span class="text-[11px] font-black tracking-[0.2em] text-emerald-700 uppercase">Nền tảng học tập cùng AI</span>
                        </div>

                        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.08]">
                            <span class="text-slate-900 block">Thắp Sáng Đam Mê</span>
                            <span class="block bg-gradient-to-r from-emerald-500 via-sky-500 to-violet-500 bg-clip-text text-transparent">Chinh Phục Đỉnh Cao</span>
                        </h1>

                        <p class="text-slate-600 text-base md:text-lg max-w-2xl leading-relaxed font-medium">
                            Chương trình đào tạo bám sát cấu trúc đề thi mới nhất, đội ngũ giáo viên giỏi chuyên môn đồng hành cùng trợ lý AI cá nhân hóa lộ trình học tập 24/7.
                        </p>

                        <div class="flex flex-wrap gap-4 pt-2">
                            <button
                                class="bg-gradient-to-r from-emerald-500 to-sky-500 hover:from-emerald-600 hover:to-sky-600 text-white font-black px-8 py-3.5 rounded-full shadow-lg shadow-emerald-500/30 hover:shadow-xl transition-all hover:scale-105 active:scale-95 flex items-center gap-2 text-sm"
                                onclick="location.href='/Auth/Register'">
                                Đăng Ký Học Thử Miễn Phí
                                <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
                            </button>
                            <button
                                class="bg-white hover:bg-slate-50 border-2 border-slate-200 text-slate-800 font-bold px-7 py-3.5 rounded-full transition-all text-sm shadow-sm"
                                onclick="location.href='/Home/Courses'">
                                Khám Phá Khóa Học
                            </button>
                        </div>

                        <!-- Stats -->
                        <div class="grid grid-cols-3 gap-4 pt-8 max-w-xl">
                            <div class="bg-white border border-emerald-100 rounded-2xl p-4 text-center shadow-sm">
                                <div class="text-2xl lg:text-3xl font-black text-emerald-600">5,000+</div>
                                <div class="text-slate-500 text-[10px] font-extrabold uppercase tracking-wider mt-1">Học viên theo học</div>
                            </div>
                            <div class="bg-white border border-sky-100 rounded-2xl p-4 text-center shadow-sm">
                                <div class="text-2xl lg:text-3xl font-black text-sky-600">98.5%</div>
                                <div class="text-slate-500 text-[10px] font-extrabold uppercase tracking-wider mt-1">Đạt nguyện vọng 1</div>
                            </div>
                            <div class="bg-white border border-amber-100 rounded-2xl p-4 text-center shadow-sm">
                                <div class="text-2xl lg:text-3xl font-black text-amber-500">15+</div>
                                <div class="text-slate-500 text-[10px] font-extrabold uppercase tracking-wider mt-1">Năm kinh nghiệm</div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column - Spotlight Cards -->
                    <div class="lg:col-span-5 relative h-[460px] hidden lg:block">
                        <!-- Course spotlight card -->
                        <div class="absolute top-0 left-0 w-[88%] rounded-3xl overflow-hidden shadow-2xl shadow-emerald-500/20 bg-gradient-to-br from-emerald-500 to-sky-500 p-6 text-white z-10">
                            <div class="flex items-center justify-between mb-4">
                                <span class="px-3 py-1 bg-white/20 rounded-full text-[10px] font-black uppercase tracking-widest">Khóa Học Nổi Bật</span>
                                <span class="material-symbols-outlined">local_fire_department</span>
                            </div>
                            <% if (spotlightCourse) { %>
                                <div class="aspect-[16/9] rounded-2xl overflow-hidden bg-white/10 mb-4">
                                    <% if (spotlightCourse.ImageUrl) { %>
                                        <img src="<%= spotlightCourse.ImageUrl %>" alt="<%= spotlightCourse.Title %>" class="w-full h-full object-cover" />
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center">
                                            <span class="material-symbols-outlined text-[56px] text-white/50">school</span>
                                        </div>
                                    <% } %>
                                </div>
                                <h4 class="font-black text-lg mb-1 line-clamp-1"><%= spotlightCourse.Title %></h4>
                                <p class="text-white/80 text-xs font-semibold mb-4">
                                    <%= spotlightCourse.TotalLessons %> buổi học ·
                                    <%= (spotlightCourse.BasePrice && Number(spotlightCourse.BasePrice) > 0) ? Number(spotlightCourse.BasePrice).toLocaleString('vi-VN') + ' đ' : 'Miễn phí' %>
                                </p>
                                <a href="/Auth/Checkout?courseId=<%= spotlightCourse.Id %>" class="inline-flex items-center gap-1.5 bg-white text-emerald-700 font-black text-xs px-4 py-2.5 rounded-full hover:scale-105 transition-all">
                                    Đăng ký ngay <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                                </a>
                            <% } else { %>
                                <p class="text-white/80 text-sm font-semibold py-8 text-center">Đang cập nhật khóa học...</p>
                            <% } %>
                        </div>

                        <!-- Teacher spotlight card -->
                        <div class="absolute bottom-0 right-0 w-[80%] rounded-3xl overflow-hidden shadow-2xl shadow-amber-500/20 bg-white border border-amber-100 p-5 z-20">
                            <span class="px-3 py-1 bg-amber-100 text-amber-700 rounded-full text-[10px] font-black uppercase tracking-widest">Giáo Viên Tiêu Biểu</span>
                            <% if (spotlightTeacher) { %>
                                <div class="flex items-center gap-4 mt-4">
                                    <img src="<%= spotlightTeacher.avatarUrl %>" alt="<%= spotlightTeacher.fullName %>" class="w-16 h-16 rounded-2xl object-cover border-2 border-amber-300 shrink-0 shadow-sm" />
                                    <div class="min-w-0">
                                        <h4 class="text-slate-900 font-extrabold text-base leading-tight truncate"><%= spotlightTeacher.fullName %></h4>
                                        <p class="text-emerald-600 text-xs font-bold truncate"><%= spotlightTeacher.subject %> · <%= spotlightTeacher.experience %>+ năm KN</p>
                                        <div class="flex items-center gap-1 mt-1">
                                            <span class="material-symbols-outlined text-amber-400 text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                            <span class="text-slate-600 text-xs font-bold"><%= spotlightTeacher.rating %> · <%= spotlightTeacher.students %>+ học sinh</span>
                                        </div>
                                    </div>
                                </div>
                            <% } else { %>
                                <p class="text-slate-500 text-sm font-semibold py-6 text-center">Đang cập nhật đội ngũ giáo viên...</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ===================== FEATURED COURSES SECTION ===================== -->
        <section class="py-28 bg-white relative overflow-hidden">
            <div class="max-w-7xl mx-auto px-6 lg:px-margin-desktop relative z-10">
                <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
                    <div class="space-y-4">
                        <div class="flex items-center gap-2 text-emerald-600">
                            <span class="w-12 h-[2px] bg-emerald-500"></span>
                            <span class="text-[10px] font-black uppercase tracking-[0.3em]">Hệ sinh thái tri thức</span>
                        </div>
                        <h2 class="text-4xl md:text-5xl font-black text-slate-900 leading-tight">Khám Phá Khóa Học</h2>
                    </div>
                    <p class="text-slate-500 max-w-sm text-base leading-relaxed font-medium">Chọn khóa học phù hợp để bắt đầu hành trình học tập rực rỡ cùng các giáo viên xuất sắc nhất.</p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <% if (courses && courses.length > 0) { %>
                        <% courses.slice(0, 4).forEach(function(course, idx) { %>
                            <% const accent = accents[idx % accents.length]; %>
                            <div class="bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 group flex flex-col">
                                <div class="h-1.5 w-full bg-gradient-to-r <%= accent.grad %>"></div>
                                <div class="relative aspect-[4/3] overflow-hidden bg-slate-50">
                                    <% if (course.ImageUrl) { %>
                                        <img alt="<%= course.Title %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" src="<%= course.ImageUrl %>" />
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center <%= accent.tint %>">
                                            <span class="material-symbols-outlined text-[80px] <%= accent.text %> opacity-40">school</span>
                                        </div>
                                    <% } %>
                                    <span class="absolute top-5 right-5 <%= accent.chip %> text-white text-[9px] font-black uppercase px-3 py-1 rounded-lg shadow-md">
                                        <%= course.CourseCode || 'ACTIVE' %>
                                    </span>
                                </div>
                                <div class="p-6 space-y-5 flex-1 flex flex-col">
                                    <h4 class="font-black text-xl text-slate-900 group-hover:text-emerald-600 transition-colors line-clamp-1"><%= course.Title %></h4>
                                    <div class="flex items-center justify-between text-slate-500 text-[13px] font-bold">
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-outlined text-[18px]">schedule</span>
                                            <%= course.TotalLessons %> buổi học
                                        </div>
                                        <div class="flex items-center gap-1 <%= accent.text %>">
                                            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span> 4.9
                                        </div>
                                    </div>
                                    <p class="text-slate-500 text-sm leading-relaxed line-clamp-2 flex-1"><%= course.Description %></p>
                                    <div class="flex justify-between items-center pt-5 border-t border-slate-100 mt-auto">
                                        <div>
                                            <span class="text-slate-400 text-[10px] uppercase font-bold">Học phí</span>
                                            <% if (course.BasePrice && Number(course.BasePrice) > 0) { %>
                                                <div class="font-extrabold text-lg <%= accent.text %>"><%= Number(course.BasePrice).toLocaleString('vi-VN') %> đ</div>
                                            <% } else { %>
                                                <div class="font-extrabold text-lg <%= accent.text %>">Miễn phí</div>
                                            <% } %>
                                        </div>
                                        <a href="/Auth/Checkout?courseId=<%= course.Id %>"
                                            class="w-12 h-12 rounded-2xl <%= accent.tint %> flex items-center justify-center <%= accent.text %> group-hover:bg-gradient-to-br group-hover:<%= accent.grad %> group-hover:text-white transition-all shadow-sm">
                                            <span class="material-symbols-outlined">arrow_forward</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-span-full py-12 text-center text-slate-400 italic">Chưa có khóa học nào được đăng tải.</div>
                    <% } %>
                </div>

                <div class="mt-16 text-center">
                    <a href="/Home/Courses"
                        class="px-12 py-4 rounded-2xl border-2 border-emerald-200 text-emerald-700 font-black transition-all shadow-sm inline-block hover:bg-gradient-to-r hover:from-emerald-500 hover:to-sky-500 hover:text-white hover:border-transparent">
                        Xem tất cả chương trình
                    </a>
                </div>
            </div>
        </section>

        <!-- ===================== FEATURED TEACHERS SECTION ===================== -->
        <section class="py-28 relative overflow-hidden" style="background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);">
            <div class="max-w-7xl mx-auto px-6 lg:px-margin-desktop relative z-10">
                <div class="text-center mb-16 space-y-4">
                    <div class="inline-flex items-center gap-2 text-violet-600 justify-center">
                        <span class="w-12 h-[2px] bg-violet-500"></span>
                        <span class="text-[10px] font-black uppercase tracking-[0.3em]">Đội ngũ tận tâm</span>
                        <span class="w-12 h-[2px] bg-violet-500"></span>
                    </div>
                    <h2 class="text-4xl md:text-5xl font-black text-slate-900">Giáo Viên Tiêu Biểu</h2>
                </div>

                <% if (teachers && teachers.length > 0) { %>
                    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
                        <% teachers.slice(0, 4).forEach(function(t, idx) { %>
                            <% const accent = accents[idx % accents.length];
                               const profile = t.Profile || {};
                               const avatarUrl = t.AvatarUrl || 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=256&auto=format&fit=crop';
                               const subject = profile.Subject || 'Toán học';
                               const title = profile.TeacherTitle || 'Giáo viên tiêu biểu';
                               const experience = (profile.TeacherExperience !== null && profile.TeacherExperience !== undefined) ? profile.TeacherExperience : 5;
                               const students = (profile.TeacherStudents !== null && profile.TeacherStudents !== undefined) ? profile.TeacherStudents : 100;
                               const rating = (profile.TeacherRating !== null && profile.TeacherRating !== undefined) ? parseFloat(profile.TeacherRating).toFixed(1) : '4.8';
                               const bio = (profile.TeacherBio || 'Giảng viên giàu kinh nghiệm ôn luyện và bồi dưỡng kiến thức toàn diện cho các em học viên.').replace(/`/g, '\\`').replace(/\$/g, '\\$').replace(/'/g, "\\'");
                            %>
                            <button type="button"
                                onclick="openTeacherDetailModal({ fullName: '<%= (t.FullName||'').replace(/'/g, "\\'") %>', avatarUrl: '<%= avatarUrl %>', subject: '<%= subject.replace(/'/g, "\\'") %>', title: '<%= title.replace(/'/g, "\\'") %>', experience: '<%= experience %>', students: '<%= students %>', rating: '<%= rating %>', bio: `<%= bio %>` })"
                                class="bg-white rounded-3xl p-6 border border-slate-100 shadow-md hover:shadow-xl transition-all hover:-translate-y-2 text-center group">
                                <div class="w-24 h-24 mx-auto rounded-full overflow-hidden border-4 <%= accent.ring %> shadow-md mb-4">
                                    <img src="<%= avatarUrl %>" alt="<%= t.FullName %>" class="w-full h-full object-cover" />
                                </div>
                                <span class="inline-block px-3 py-1 rounded-full <%= accent.tint %> <%= accent.text %> text-[10px] font-black uppercase tracking-wide mb-2"><%= subject %></span>
                                <h4 class="font-black text-slate-900 text-base leading-tight mb-1"><%= t.FullName %></h4>
                                <p class="text-slate-500 text-xs font-semibold mb-3 line-clamp-1"><%= title %></p>
                                <div class="flex items-center justify-center gap-1 text-amber-500 text-xs font-bold">
                                    <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                    <%= rating %> · <%= experience %>+ năm KN
                                </div>
                                <span class="mt-4 inline-flex items-center gap-1 text-xs font-black <%= accent.text %> opacity-0 group-hover:opacity-100 transition-opacity">
                                    Xem hồ sơ <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                                </span>
                            </button>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="py-12 text-center text-slate-400 italic">Chưa có thông tin giáo viên.</div>
                <% } %>

                <div class="mt-16 text-center">
                    <a href="/Home/Teachers"
                        class="px-12 py-4 rounded-2xl border-2 border-violet-200 text-violet-700 font-black transition-all shadow-sm inline-block hover:bg-gradient-to-r hover:from-violet-500 hover:to-sky-500 hover:text-white hover:border-transparent">
                        Xem toàn bộ đội ngũ giảng viên
                    </a>
                </div>
            </div>
        </section>

        <!-- ===================== INFORMATION BENTO GRID SECTION ===================== -->
        <section class="py-28 relative" style="background: #fdfbf7;">
            <div class="max-w-7xl mx-auto px-6 lg:px-margin-desktop relative z-10">
                <div class="text-center mb-20 space-y-5">
                    <div class="inline-block px-4 py-2 bg-emerald-50 border border-emerald-100 rounded-full text-emerald-700 text-[10px] font-black uppercase tracking-[0.3em]">Nền Tảng Giáo Dục Hiện Đại</div>
                    <h2 class="text-4xl md:text-5xl font-black text-slate-900">Thông Tin Trung Tâm</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                    <!-- Main Feature -->
                    <div class="md:col-span-8 bg-white rounded-3xl p-8 flex flex-col justify-between group overflow-hidden relative border border-slate-100 shadow-lg" style="min-height: 260px;">
                        <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-emerald-50 to-transparent pointer-events-none"></div>
                        <div class="relative z-10">
                            <span class="bg-gradient-to-r from-emerald-500 to-sky-500 text-white text-[10px] font-black tracking-widest uppercase px-3 py-1 rounded-lg mb-6 inline-block">Sứ Mệnh &amp; Tầm Nhìn</span>
                            <h3 class="text-3xl md:text-4xl font-black text-slate-900 max-w-xl leading-tight">Kiến tạo tương lai số thông qua giáo dục khai phóng</h3>
                            <p class="text-slate-500 text-lg font-light max-w-lg mt-4 leading-relaxed">Chúng tôi cam kết mang lại trải nghiệm học tập vượt trội, kết hợp giữa tri thức hàn lâm và công nghệ AI tiên tiến nhất hiện nay.</p>
                        </div>
                        <div class="flex items-center gap-4 mt-6 relative z-10">
                            <div class="flex -space-x-4">
                                <div class="w-12 h-12 rounded-full border-2 border-white bg-slate-100 flex items-center justify-center font-black text-emerald-600 text-xs shadow-sm">Edu</div>
                                <div class="w-12 h-12 rounded-full border-2 border-white bg-gradient-to-br from-emerald-500 to-sky-500 flex items-center justify-center shadow-lg">
                                    <span class="material-symbols-outlined text-white">hub</span>
                                </div>
                            </div>
                            <span class="text-slate-500 text-xs font-bold">Hệ sinh thái đào tạo toàn diện</span>
                        </div>
                    </div>

                    <!-- Certificate -->
                    <div class="md:col-span-4 bg-white rounded-3xl p-8 flex flex-col justify-between border border-slate-100 hover:border-amber-200 transition-all shadow-lg">
                        <div class="w-16 h-16 bg-amber-50 rounded-2xl flex items-center justify-center mb-6 border border-amber-100">
                            <span class="material-symbols-outlined text-amber-500 text-[36px]">workspace_premium</span>
                        </div>
                        <div>
                            <h3 class="text-2xl font-black text-slate-900 mb-2">Chứng Chỉ Quốc Tế</h3>
                            <p class="text-slate-500 text-sm font-medium leading-relaxed">Hệ thống văn bằng và chứng chỉ được công nhận bởi các đối tác giáo dục uy tín.</p>
                        </div>
                    </div>

                    <!-- Global Network -->
                    <div class="md:col-span-4 bg-white rounded-3xl p-8 flex flex-col justify-between border border-slate-100 hover:border-sky-200 transition-all shadow-lg">
                        <div class="w-16 h-16 bg-sky-50 rounded-2xl flex items-center justify-center mb-6 border border-sky-100">
                            <span class="material-symbols-outlined text-sky-500 text-[36px]">public</span>
                        </div>
                        <div>
                            <h3 class="text-2xl font-black text-slate-900 mb-2">Mạng Lưới Toàn Cầu</h3>
                            <p class="text-slate-500 text-sm font-medium leading-relaxed">Kết nối cộng đồng học viên tại hơn 10 quốc gia, mở rộng cơ hội giao lưu quốc tế.</p>
                        </div>
                    </div>

                    <!-- Facilities -->
                    <div class="md:col-span-8 bg-white rounded-3xl p-8 flex flex-col lg:flex-row gap-8 border border-slate-100 overflow-hidden shadow-lg">
                        <div class="flex-1 flex flex-col justify-center">
                            <div class="w-16 h-16 bg-violet-50 rounded-2xl flex items-center justify-center mb-6 border border-violet-100">
                                <span class="material-symbols-outlined text-violet-500 text-[32px]">apartment</span>
                            </div>
                            <h3 class="text-2xl md:text-3xl font-black text-slate-900 mb-4 leading-tight">Cơ Sở Vật Chất Hiện Đại</h3>
                            <p class="text-slate-500 text-sm font-medium leading-relaxed">Không gian học tập cảm hứng với trang thiết bị 4.0 giúp tối ưu hóa sự sáng tạo và tập trung.</p>
                            <div class="mt-6 flex items-center gap-2">
                                <span class="px-4 py-2 rounded-full text-violet-700 text-[10px] font-black uppercase tracking-widest border border-violet-200 bg-violet-50">Tiêu chuẩn 5 sao</span>
                            </div>
                        </div>
                        <div class="flex-1 flex items-end justify-between gap-4 p-6 rounded-2xl bg-slate-50 border border-slate-100">
                            <% [
                                { h: '6rem', idx: 0 },
                                { h: '10rem', idx: 1 },
                                { h: '14rem', idx: 3 },
                                { h: '8rem', idx: 2 },
                                { h: '11rem', idx: 1 }
                            ].forEach(function(bar) { %>
                                <% const a = accents[bar.idx]; %>
                                <div class="w-full rounded-xl relative overflow-hidden <%= a.tint %>" style="height: <%= bar.h %>;">
                                    <div class="absolute bottom-0 w-full rounded-xl bg-gradient-to-t <%= a.grad %>" style="height: 70%;"></div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Floating Buttons -->
    <div class="fixed bottom-10 right-10 z-[100] flex flex-col gap-3">
        <a class="w-14 h-14 bg-[#0068ff] rounded-full flex items-center justify-center shadow-2xl hover:scale-110 transition-all contact-shake border border-white/40" href="#">
            <span class="material-symbols-outlined text-white text-[26px]">chat</span>
        </a>
        <a class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-sky-500 rounded-full flex items-center justify-center shadow-2xl hover:scale-110 transition-all contact-shake border border-white/40" href="tel:0123456789">
            <span class="material-symbols-outlined text-white text-[28px]">call</span>
        </a>
    </div>

    <!-- Footer -->
    <footer style="background-color: #6c2f00; color: white;" class="pt-8 pb-5 relative overflow-hidden border-t border-white/10">
        <div class="max-w-7xl mx-auto px-6 lg:px-margin-desktop relative z-10">
            <div class="grid lg:grid-cols-12 gap-8 mb-6">
                <div class="lg:col-span-4 space-y-8">
                    <span class="text-white font-black text-xl">TrungTâmOnline</span>
                    <p class="text-white/70 text-sm leading-relaxed max-w-sm font-medium">
                        Nền tảng giáo dục trực tuyến cao cấp, ứng dụng trí tuệ nhân tạo để kiến tạo lộ trình học tập tối ưu cho thế hệ tương lai.
                    </p>
                    <div class="flex gap-4 pt-4">
                        <a class="w-11 h-11 rounded-full bg-white/10 border border-white/20 flex items-center justify-center hover:bg-white hover:text-primary transition-all text-white" href="#">
                            <span class="material-symbols-outlined text-[18px]">public</span>
                        </a>
                        <a class="w-11 h-11 rounded-full bg-white/10 border border-white/20 flex items-center justify-center hover:bg-white hover:text-primary transition-all text-white" href="#">
                            <span class="material-symbols-outlined text-[18px]">mail</span>
                        </a>
                    </div>
                </div>
                <div class="lg:col-span-2 space-y-8">
                    <h4 class="text-[11px] font-black text-white/50 uppercase tracking-widest">Đào tạo</h4>
                    <ul class="space-y-4 text-white/70 text-sm font-bold">
                        <li><a class="hover:text-white transition-colors" href="/Home/Courses">Luyện Thi Đại Học</a></li>
                        <li><a class="hover:text-white transition-colors" href="/Home/Courses">Tiếng Anh IELTS</a></li>
                        <li><a class="hover:text-white transition-colors" href="/Home/Courses">Toán - Lý - Hóa</a></li>
                    </ul>
                </div>
                <div class="lg:col-span-2 space-y-8">
                    <h4 class="text-[11px] font-black text-white/50 uppercase tracking-widest">Hỗ Trợ</h4>
                    <ul class="space-y-4 text-white/70 text-sm font-bold">
                        <li><a class="hover:text-white transition-colors" href="/Home/Privacy">Chính Sách Bảo Mật</a></li>
                        <li><a class="hover:text-white transition-colors" href="/Home/Privacy">Điều Khoản Sử Dụng</a></li>
                        <li><a class="hover:text-white transition-colors" href="/Auth/Register">Hướng Dẫn Đăng Ký</a></li>
                    </ul>
                </div>
                <div class="lg:col-span-4 space-y-8">
                    <h4 class="text-[11px] font-black text-white/50 uppercase tracking-widest">Liên Hệ</h4>
                    <p class="text-white/70 text-sm font-medium">Hotline: 0123 456 789</p>
                    <p class="text-white/70 text-sm font-medium">Email: contact@trungtamonline.vn</p>
                </div>
            </div>
            <div class="pt-4 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-3">
                <p class="text-white/30 text-[10px] font-bold uppercase tracking-widest">© 2026 TRUNGTÂMONLINE. ALL RIGHTS RESERVED.</p>
                <div class="flex gap-12">
                    <a class="text-white/30 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-colors" href="/Home/Privacy">Privacy Policy</a>
                    <a class="text-white/30 hover:text-white text-[10px] font-bold uppercase tracking-widest transition-colors" href="/Home/Privacy">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Teacher Detail Modal -->
    <div id="teacherDetailModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-md z-[200] hidden items-center justify-center p-4" onclick="handleOutsideClick(event)">
        <div class="bg-white rounded-3xl max-w-6xl w-full overflow-hidden shadow-2xl transform transition-all duration-300 scale-95 opacity-0 flex flex-col md:flex-row relative" id="teacherModalContent" onclick="event.stopPropagation()">
            <button onclick="closeTeacherDetailModal()" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 transition-colors w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center z-10">
                <span class="material-symbols-outlined text-[24px] font-bold">close</span>
            </button>

            <div class="md:w-[30%] bg-gradient-to-br from-emerald-50 to-sky-50 p-12 border-b md:border-b-0 md:border-r border-slate-100 flex flex-col items-center justify-center text-center">
                <div class="w-48 h-48 rounded-full border-4 border-white overflow-hidden bg-white shadow-md mb-6">
                    <img id="modalTeacherAvatar" class="w-full h-full object-cover" src="" alt="Teacher Avatar" />
                </div>
                <span id="modalTeacherSubject" class="bg-gradient-to-r from-emerald-500 to-sky-500 text-white text-xs font-bold px-4 py-1 rounded-full shadow-sm mb-4"></span>
                <h3 id="modalTeacherName" class="text-3xl font-extrabold text-slate-900 mb-2 whitespace-nowrap"></h3>
                <p id="modalTeacherTitle" class="text-sm text-on-surface-variant font-medium mb-10 px-2"></p>

                <div class="grid grid-cols-3 gap-2 w-full pt-6 border-t border-slate-200">
                    <div class="text-center">
                        <span id="modalTeacherExp" class="block text-2xl font-extrabold text-emerald-600"></span>
                        <span class="text-[10px] text-outline uppercase font-bold tracking-wide">Năm KN</span>
                    </div>
                    <div class="text-center">
                        <span id="modalTeacherStudents" class="block text-2xl font-extrabold text-sky-600"></span>
                        <span class="text-[10px] text-outline uppercase font-bold tracking-wide">Học sinh</span>
                    </div>
                    <div class="text-center">
                        <span id="modalTeacherRating" class="block text-2xl font-extrabold text-amber-500 flex items-center justify-center gap-0.5"></span>
                        <span class="text-[10px] text-outline uppercase font-bold tracking-wide">Đánh giá</span>
                    </div>
                </div>
            </div>

            <div class="md:w-[70%] p-12 flex flex-col justify-between">
                <div class="flex-grow">
                    <h4 class="text-base font-black text-emerald-700 uppercase tracking-wider mb-6"><i class="fa-solid fa-graduation-cap"></i> Tiểu sử & Kinh nghiệm giảng dạy</h4>
                    <div class="overflow-y-auto max-h-[500px] pr-4 text-justify">
                        <p id="modalTeacherBio" class="text-base text-on-surface-variant leading-relaxed font-medium" style="white-space: pre-line;"></p>
                    </div>
                </div>
                <div class="mt-10 pt-6 border-t border-slate-100 flex justify-end">
                    <button onclick="closeTeacherDetailModal()" class="px-8 py-3.5 bg-gradient-to-r from-emerald-500 to-sky-500 hover:from-emerald-600 hover:to-sky-600 text-white text-base font-bold rounded-xl shadow-lg transition-all">
                        Đóng cửa sổ
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openTeacherDetailModal(data) {
            document.getElementById('modalTeacherAvatar').src = data.avatarUrl;
            document.getElementById('modalTeacherSubject').textContent = data.subject;
            document.getElementById('modalTeacherName').textContent = data.fullName;
            document.getElementById('modalTeacherTitle').textContent = data.title;
            document.getElementById('modalTeacherExp').textContent = data.experience + '+';
            document.getElementById('modalTeacherStudents').textContent = data.students + '+';
            document.getElementById('modalTeacherRating').innerHTML = data.rating + ' <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: \'FILL\' 1; vertical-align: middle;">star</span>';
            document.getElementById('modalTeacherBio').textContent = data.bio;

            const modal = document.getElementById('teacherDetailModal');
            const content = document.getElementById('teacherModalContent');

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeTeacherDetailModal() {
            const modal = document.getElementById('teacherDetailModal');
            const content = document.getElementById('teacherModalContent');

            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            document.body.style.overflow = '';
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
            }, 300);
        }

        function handleOutsideClick(event) {
            closeTeacherDetailModal();
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeTeacherDetailModal();
            }
        });
    </script>
</body>

</html>
