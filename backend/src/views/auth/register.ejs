<!DOCTYPE html>
<html class="scroll-smooth" lang="vi">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Đăng Ký Tài Khoản - Trung Tâm Học Thêm Online</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
        <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    "colors": {
                        "primary": "#1e3a8a", // Deeper Edu Blue (Blue 900)
                        "on-primary": "#ffffff",
                        "primary-container": "#dbeafe",
                        "on-primary-container": "#172554",
                        "secondary": "#2563eb", // More saturated Blue 600
                        "surface": "#fdfbf7",
                        "on-surface": "#0b1120",
                        "surface-variant": "#f6f4eb",
                        "on-surface-variant": "#334155",
                        "outline": "#94a3b8",
                        "background": "#fdfbf7",
                        "on-background": "#0b1120",
                        "surface-container-low": "#faf8f0",
                        "surface-container": "#f6f4eb",
                        "surface-container-high": "#f0eee2",
                        "surface-container-highest": "#eae8d8",
                        "surface-container-lowest": "#ffffff",
                        "outline-variant": "#cbd5e1",
                        "vibrant-blue": "#1d4ed8", // Darker Blue 700
                        "vibrant-sky": "#0369a1" // Darker Sky 800
                    },
                    "borderRadius": {
                        "DEFAULT": "0.5rem",
                        "lg": "0.75rem",
                        "xl": "1rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "max-width": "1280px",
                        "gutter": "24px",
                        "margin-mobile": "16px",
                        "margin-desktop": "64px",
                        "base": "8px"
                    },
                    "fontFamily": {
                        "sans": ["Inter", "Manrope", "sans-serif"],
                        "serif": ["Source Serif 4", "serif"]
                    }
                }
            }
        }
    </script>
</head>
<body class="antialiased font-sans bg-surface">
    <main class="pt-0">
        
<style>
  .glass-premium {
      background: rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .blended-gradient {
      background: linear-gradient(135deg, #1e3a8a 0%, #172554 100%);
  }

    .register-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 3rem 2rem;
        position: relative;
        overflow: hidden;
        box-sizing: border-box;
        background-color: #22386e;
    }
    .register-container::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(to right, rgba(255, 255, 255, 0.055) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(255, 255, 255, 0.055) 1px, transparent 1px);
        background-size: 54px 54px;
        -webkit-mask-image: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.4) 45%, transparent 100%);
        mask-image: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.4) 45%, transparent 100%);
        z-index: 0;
    }
    .register-container::after {
        content: '';
        position: absolute;
        bottom: -20%;
        left: -10%;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(30, 58, 138, 0.06) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }
    .register-card {
        background: rgba(59, 130, 246, 0.14);
        backdrop-filter: blur(28px);
        -webkit-backdrop-filter: blur(28px);
        border: 1.5px solid rgba(147, 197, 253, 0.3);
        border-radius: 24px;
        padding: 1.5rem 2rem;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(255,255,255,0.05) inset;
        animation: fadeSlideIn 0.4s ease;
        position: relative;
        z-index: 1;
    }
    @keyframes fadeSlideIn {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .register-card h2 { color: #ffffff !important; }
    .register-card p { color: rgba(255,255,255,0.72) !important; }
    .form-group-custom {
        margin-bottom: 0.85rem;
    }
    .form-label-custom {
        color: rgba(255,255,255,0.8) !important;
        font-weight: 700;
        font-size: 0.82rem;
        margin-bottom: 0.5rem;
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .register-card .form-input-custom {
        background: rgba(8, 14, 30, 0.4) !important;
        border: 1.5px solid rgba(147, 197, 253, 0.25) !important;
        color: #ffffff !important;
        border-radius: 12px;
        padding: 0.55rem 1rem;
        width: 100%;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }
    .register-card .form-input-custom::placeholder { color: rgba(255,255,255,0.45) !important; }
    .register-card .form-input-custom:focus {
        outline: none;
        border-color: #93c5fd !important;
        background: rgba(8, 14, 30, 0.55) !important;
        box-shadow: 0 0 0 3px rgba(147, 197, 253, 0.25) !important;
    }
    .register-card .form-input-custom.field-error {
        border-color: #ef4444 !important;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2) !important;
    }
    .register-card .form-label-custom.field-error-label {
        color: #f87171 !important;
    }
    .field-error-msg {
        display: none;
        color: #f87171;
        font-size: 0.78rem;
        margin-top: 0.4rem;
    }
    .form-input-custom.field-error + .field-error-msg {
        display: block;
    }
    .register-card select.form-input-custom option {
        background: #0b1120;
        color: #ffffff;
    }
    .btn-submit {
        width: 100%;
        background: linear-gradient(135deg, #1e3a8a 0%, #172554 100%);
        color: #fff;
        border: none;
        padding: 0.7rem;
        border-radius: 50px;
        font-weight: 800;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        box-shadow: 0 8px 24px rgba(30, 58, 138, 0.2);
    }
    .btn-submit:hover {
        background: linear-gradient(135deg, #2563eb 0%, #1e3a8a 100%);
        transform: translateY(-2px);
        box-shadow: 0 16px 32px rgba(30, 58, 138, 0.3);
    }
    .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
    .register-divider {
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        padding-top: 0.75rem;
        margin-top: 0.75rem;
        text-align: center;
        font-size: 0.9rem;
        color: rgba(255,255,255,0.72);
    }
    .register-divider a { color: #93c5fd; font-weight: 700; text-decoration: none; }
    .register-divider a:hover { text-decoration: underline; }
    .error-box {
        color: #ba1a1a;
        font-size: 0.88rem;
        font-weight: 600;
        background: #ffdad6;
        border: 1px solid #ffdad6;
        border-radius: 10px;
        padding: 0.6rem 0.85rem;
        margin-bottom: 1.25rem;
    }
</style>

<div class="register-container">
    <div class="register-card">
        <div style="text-align: center; margin-bottom: 1rem;">
            <img src="/images/logo.png" alt="Trung Tâm Online" style="height: 52px; width: auto; margin: 0 auto 0.5rem; display: block; filter: drop-shadow(0 6px 16px rgba(0,0,0,0.3));">
            <h2 style="font-size: 1.55rem; font-weight: 800; margin-bottom: 0.25rem;">Tạo Tài Khoản Mới</h2>
            <p style="font-size: 0.9rem; margin-top: 0.25rem;">Đăng ký để bắt đầu hành trình học tập.</p>
        </div>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="error-box"><i class="fa-solid fa-circle-exclamation"></i> <%= errorMessage %></div>
        <% } %>

        <form action="/Auth/Register" method="post" autocomplete="off" id="registerForm" novalidate>
            <div class="form-group-custom">
                <label class="form-label-custom">Họ và Tên</label>
                <input type="text" name="fullName" class="form-input-custom" placeholder="Nguyễn Văn A" required />
                <span class="field-error-msg">Vui lòng điền vào trường này.</span>
            </div>
            <div class="form-group-custom">
                <label class="form-label-custom">Email</label>
                <input type="email" name="email" class="form-input-custom" placeholder="email@example.com" required />
                <span class="field-error-msg">Vui lòng điền vào trường này.</span>
            </div>
            <div class="form-group-custom">
                <label class="form-label-custom">Số điện thoại</label>
                <input type="tel" name="phone" class="form-input-custom" placeholder="0901234567" required />
                <span class="field-error-msg">Vui lòng điền vào trường này.</span>
            </div>
            <div class="form-group-custom">
                <label class="form-label-custom">Mật khẩu</label>
                <input type="password" name="password" class="form-input-custom" placeholder="Tối thiểu 6 ký tự" required autocomplete="new-password" />
                <span class="field-error-msg">Vui lòng điền vào trường này.</span>
            </div>
            <div class="form-group-custom" style="margin-bottom: 1.1rem;">
                <label class="form-label-custom">Vai trò</label>
                <select name="role" class="form-input-custom">
                    <option value="STUDENT">Học Viên</option>
                    <option value="TEACHER">Giáo Viên</option>
                    <option value="PARENT">Phụ Huynh</option>
                </select>
            </div>
            <button type="submit" class="btn-submit" id="submitBtn">
                <i class="fa-solid fa-user-check"></i> Đăng Ký Ngay
            </button>
        </form>

        <div class="register-divider">
            Đã có tài khoản? <a href="/Auth/Login">Đăng nhập</a>
        </div>
    </div>
</div>

<script>
    const registerForm = document.getElementById('registerForm');
    const requiredFields = registerForm.querySelectorAll('[required]');

    function markField(field, hasError) {
        field.classList.toggle('field-error', hasError);
        const label = field.closest('.form-group-custom').querySelector('.form-label-custom');
        if (label) label.classList.toggle('field-error-label', hasError);
    }

    requiredFields.forEach(field => {
        field.addEventListener('input', () => {
            if (field.value.trim()) markField(field, false);
        });
    });

    registerForm.addEventListener('submit', function(e) {
        let hasInvalid = false;
        requiredFields.forEach(field => {
            const isEmpty = !field.value.trim();
            markField(field, isEmpty);
            if (isEmpty) hasInvalid = true;
        });
        if (hasInvalid) {
            e.preventDefault();
            return;
        }
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';
    });
</script>

    </main>
</body>
</html>